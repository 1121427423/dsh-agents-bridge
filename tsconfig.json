{
  "compilerOptions": {
    "target": "esnext",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["esnext", "dom", "dom.iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "outDir": "lib/types",
    "rootDir": "src",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "react": ["./vendor/react/@types/react/index.d.ts"],
      "react/*": ["./vendor/react/@types/react/*"],
      "csstype": ["./vendor/react/csstype/index.d.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["tests", "node_modules", "lib"]
}
